# Copy to .env and fill in real values. .env is gitignored; this file documents what the app needs.
# Every variable is optional for local development. Never put real keys in this file.

# Database: empty = embedded PGlite in .data/ (local dev). Production: Supabase transaction-pooler URI.
DATABASE_URL=

# AI (any OpenAI-compatible API). Empty key = rule-based hints; AI-only tools are disabled.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ai.ohack.dev/v1
AI_MODEL=muse-wonder
# AI_DISABLE_THINKING=true   # for Qwen-style hosts

# Solana proofs for certificates/funder reports (devnet is fine). Empty = hashed but not anchored.
SOLANA_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com

# Demo data (seeded into an empty database). Set both to false for a real install.
SEED_DEMO_DATA=true
SHOW_DEMO_ACCOUNTS=true
DEMO_PASSWORD=cic-demo-2026
